{
  "name": "[YogaKit] Homepage Returns 200",
  "type": "api",
  "subtype": "http",
  "config": {
    "request": { "method": "GET", "url": "https://yoga-kit.vercel.app/", "headers": {}, "body": "" },
    "assertions": [
      { "type": "statusCode", "operator": "is", "target": 200 },
      { "type": "responseTime", "operator": "lessThan", "target": 2000 }
    ]
  },
  "options": {
    "tick_every": 300,
    "min_failure_duration": 0,
    "min_location_failed": 1,
    "follow_redirects": true,
    "retry": { "count": 2, "interval": 300 },
    "monitor_options": { "notify_audit": false, "renotify_interval": 0 },
    "monitor_name": "[YogaKit] Synthetic: Homepage Returns 200"
  },
  "locations": ["aws:us-east-1", "aws:us-west-2"],
  "tags": ["env:prod", "service:yogakit", "managed_by:git", "yogakit:homepage-200"],
  "status": "live",
  "message": "@syntheticstesting@gmail.com"
}
