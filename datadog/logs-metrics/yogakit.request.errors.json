{
  "data": {
    "type": "logs_metrics",
    "id": "yogakit.request.errors",
    "attributes": {
      "compute": { "aggregation_type": "count" },
      "filter": { "query": "service:yogakit @environment:production status:error" },
      "group_by": [{ "path": "@error.kind", "tag_name": "kind" }]
    }
  }
}
