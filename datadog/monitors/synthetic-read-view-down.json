{
  "name": "[YogaKit] Synthetic Test Runs Missing",
  "type": "query alert",
  "query": "sum(last_15m):sum:synthetics.test_runs{env:prod,service:yogakit}.as_count() < 1",
  "message": "No YogaKit synthetic test runs arrived for 15 minutes; verify Synthetics scheduling and ingestion. @syntheticstesting@gmail.com",
  "tags": ["env:prod", "service:yogakit", "managed_by:git", "yogakit:synthetic-read-view-down"],
  "options": {
    "notify_audit": false,
    "require_full_window": false,
    "new_host_delay": 300,
    "evaluation_delay": 0,
    "notify_no_data": true,
    "no_data_timeframe": 20,
    "thresholds": { "critical": 1 }
  }
}
