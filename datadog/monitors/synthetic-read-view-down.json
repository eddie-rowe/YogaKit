{
  "name": "[YogaKit] Synthetic: Read View Unreachable",
  "type": "query alert",
  "query": "avg(last_15m):avg:synthetics.http.error{env:prod,service:yogakit,yogakit:read-view-200} > 0",
  "message": "The public read-view synthetic is failing or its expected content is missing. Check the deployment and read route. @syntheticstesting@gmail.com",
  "tags": ["env:prod", "service:yogakit", "managed_by:git", "yogakit:synthetic-read-view-down"],
  "options": {
    "notify_audit": false,
    "require_full_window": false,
    "new_host_delay": 300,
    "evaluation_delay": 0,
    "notify_no_data": true,
    "no_data_timeframe": 20,
    "thresholds": { "critical": 0 }
  }
}
