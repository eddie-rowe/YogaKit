{
  "name": "[YogaKit] Largest Contentful Paint p75 > 2.5s",
  "type": "query alert",
  "query": "avg(last_1h):p75:rum.view.largest_contentful_paint{service:yogakit,env:prod} > 2500",
  "message": "Read-view LCP p75 exceeded the RULE-L6 mobile-performance floor for YogaKit. @syntheticstesting@gmail.com",
  "tags": ["env:prod", "service:yogakit", "managed_by:git", "yogakit:web-vitals-lcp"],
  "options": {
    "notify_audit": false,
    "require_full_window": false,
    "new_host_delay": 300,
    "evaluation_delay": 0,
    "notify_no_data": true,
    "no_data_timeframe": 120,
    "thresholds": { "critical": 2500, "warning": 2000 }
  }
}
