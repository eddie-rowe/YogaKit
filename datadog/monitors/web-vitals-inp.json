{
  "name": "[YogaKit] Real-user Page Load p75 > 4s",
  "type": "query alert",
  "query": "avg(last_1h):p75:rum.measure.view.loading_time{service:yogakit,env:prod,!session_type:synthetics,!browser:HeadlessChrome} > 4000000000",
  "message": "Real-user page-load p75 exceeded threshold for YogaKit. @syntheticstesting@gmail.com",
  "tags": ["env:prod", "service:yogakit", "managed_by:git", "yogakit:web-vitals-inp"],
  "options": {
    "notify_audit": false,
    "require_full_window": false,
    "new_host_delay": 300,
    "evaluation_delay": 0,
    "notify_no_data": false,
    "thresholds": { "critical": 4000000000, "warning": 2500000000 }
  }
}
