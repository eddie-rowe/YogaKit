{
  "name": "[YogaKit] Server Error Rate > 5%",
  "type": "query alert",
  "query": "sum(last_15m):sum:trace.next_js.BaseServer.handleRequest.hits.by_http_status{service:yogakit,env:prod,http.status_code:5*}.as_rate() / sum:trace.next_js.BaseServer.handleRequest.hits{service:yogakit,env:prod}.as_rate() * 100 > 5",
  "message": "Server-side request error rate exceeded threshold for YogaKit. @syntheticstesting@gmail.com",
  "tags": ["env:prod", "service:yogakit", "managed_by:git", "yogakit:api-error-rate"],
  "options": {
    "notify_audit": false,
    "require_full_window": false,
    "new_host_delay": 300,
    "evaluation_delay": 0,
    "notify_no_data": false,
    "thresholds": { "critical": 5, "warning": 2 }
  }
}
