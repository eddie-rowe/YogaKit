{
  "title": "[YogaKit] Health",
  "description": "Journey outcomes, RUM, APM, logs, and read-view SLI health for YogaKit. Filter and compare by version to correlate regressions with deployments. See docs/OBSERVABILITY.md.",
  "layout_type": "ordered",
  "template_variables": [
    { "name": "version", "prefix": "version", "available_values": [], "default": "*" }
  ],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "Client (RUM)",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 11,
            "definition": {
              "type": "timeseries",
              "title": "RUM error count",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "rum",
                      "name": "query1",
                      "indexes": ["*"],
                      "compute": { "aggregation": "count" },
                      "search": { "query": "@type:error service:yogakit env:prod version:$version -@session.type:synthetics -@browser.name:HeadlessChrome" }
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "bars"
                }
              ]
            },
            "layout": { "x": 0, "y": 0, "width": 4, "height": 3 }
          },
          {
            "id": 12,
            "definition": {
              "type": "timeseries",
              "title": "Largest Contentful Paint p75",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "p75:rum.measure.view.largest_contentful_paint{service:yogakit,env:prod,version:$version,!session_type:synthetics,!browser:HeadlessChrome}"
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 4, "y": 0, "width": 4, "height": 3 }
          },
          {
            "id": 13,
            "definition": {
              "type": "timeseries",
              "title": "Real-user page load p75",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "p75:rum.measure.view.loading_time{service:yogakit,env:prod,version:$version,!session_type:synthetics,!browser:HeadlessChrome}"
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 8, "y": 0, "width": 4, "height": 3 }
          },
          {
            "id": 14,
            "definition": {
              "type": "timeseries",
              "title": "Page views by scrubbed view",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "rum",
                      "name": "query1",
                      "indexes": ["*"],
                      "compute": { "aggregation": "count" },
                      "search": { "query": "@type:view service:yogakit env:prod version:$version -@session.type:synthetics -@browser.name:HeadlessChrome" },
                      "group_by": [
                        {
                          "facet": "@view.name",
                          "limit": 10,
                          "sort": { "aggregation": "count", "order": "desc" }
                        }
                      ]
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "bars"
                }
              ]
            },
            "layout": { "x": 0, "y": 3, "width": 4, "height": 3 }
          }
        ]
      },
      "layout": { "x": 0, "y": 0, "width": 12, "height": 7 }
    },
    {
      "id": 2,
      "definition": {
        "type": "group",
        "title": "Server (APM)",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 21,
            "definition": {
              "type": "timeseries",
              "title": "Request error rate",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "errors",
                      "query": "sum:trace.next_js.BaseServer.handleRequest.hits.by_http_status{service:yogakit,env:prod,version:$version,http.status_code:5*}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "requests",
                      "query": "sum:trace.next_js.BaseServer.handleRequest.hits{service:yogakit,env:prod,version:$version}.as_rate()"
                    }
                  ],
                  "formulas": [{ "formula": "errors / requests * 100", "alias": "error rate (%)" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 }
          },
          {
            "id": 22,
            "definition": {
              "type": "timeseries",
              "title": "Request latency p95",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "p95:trace.next_js.BaseServer.handleRequest{service:yogakit,env:prod,version:$version}"
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 6, "y": 0, "width": 6, "height": 3 }
          },
          {
            "id": 24,
            "definition": {
              "type": "log_stream",
              "title": "Recent server errors",
              "query": "service:yogakit @environment:production status:error",
              "columns": ["timestamp", "status", "@path", "@statusCode", "@requestId"],
              "message_display": "inline"
            },
            "layout": { "x": 0, "y": 3, "width": 12, "height": 3 }
          }
        ]
      },
      "layout": { "x": 0, "y": 7, "width": 12, "height": 7 }
    },
    {
      "id": 3,
      "definition": {
        "type": "group",
        "title": "Uptime (Synthetics)",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 31,
            "definition": {
              "type": "timeseries",
              "title": "Synthetic test runs",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:synthetics.test_runs{service:yogakit,env:prod}.as_count()"
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 }
          }
        ]
      },
      "layout": { "x": 0, "y": 14, "width": 12, "height": 4 }
    }
  ]
}
