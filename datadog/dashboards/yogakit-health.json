{
  "title": "[YogaKit] Health",
  "description": "RUM error rate, web vitals, server error rate/latency, and synthetic uptime for YogaKit. See docs/OBSERVABILITY.md. Managed as-code via scripts/datadog/sync.mjs --type dashboards --apply.",
  "layout_type": "ordered",
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "title": "Client (RUM)",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 11,
            "definition": {
              "type": "timeseries",
              "title": "RUM error count",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "rum",
                      "name": "query1",
                      "indexes": ["*"],
                      "compute": { "aggregation": "count" },
                      "search": { "query": "@type:error service:yogakit env:prod" }
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "bars"
                }
              ]
            },
            "layout": { "x": 0, "y": 0, "width": 4, "height": 3 }
          },
          {
            "id": 12,
            "definition": {
              "type": "timeseries",
              "title": "Largest Contentful Paint p75",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "p75:rum.view.largest_contentful_paint{service:yogakit,env:prod}"
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 4, "y": 0, "width": 4, "height": 3 }
          },
          {
            "id": 13,
            "definition": {
              "type": "timeseries",
              "title": "Interaction to Next Paint p75",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "p75:rum.view.interaction_to_next_paint{service:yogakit,env:prod}"
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 8, "y": 0, "width": 4, "height": 3 }
          },
          {
            "id": 14,
            "definition": {
              "type": "timeseries",
              "title": "Page views by scrubbed view",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "rum",
                      "name": "query1",
                      "indexes": ["*"],
                      "compute": { "aggregation": "count" },
                      "search": { "query": "@type:view service:yogakit env:prod" }
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "bars"
                }
              ]
            },
            "layout": { "x": 0, "y": 3, "width": 4, "height": 3 }
          }
        ]
      },
      "layout": { "x": 0, "y": 0, "width": 12, "height": 7 }
    },
    {
      "id": 2,
      "definition": {
        "type": "group",
        "title": "Server (APM)",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 21,
            "definition": {
              "type": "timeseries",
              "title": "Request error rate",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:trace.next_js.BaseServer.handleRequest.errors{service:yogakit,env:prod}.as_rate()"
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 }
          },
          {
            "id": 22,
            "definition": {
              "type": "timeseries",
              "title": "Request latency p95",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "p95:trace.next_js.BaseServer.handleRequest{service:yogakit,env:prod}"
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 6, "y": 0, "width": 6, "height": 3 }
          }
        ]
      },
      "layout": { "x": 0, "y": 7, "width": 12, "height": 4 }
    },
    {
      "id": 3,
      "definition": {
        "type": "group",
        "title": "Uptime (Synthetics)",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 31,
            "definition": {
              "type": "timeseries",
              "title": "Synthetic availability",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:synthetics.http.availability{service:yogakit,env:prod}"
                    }
                  ],
                  "formulas": [{ "formula": "query1" }],
                  "display_type": "line"
                }
              ]
            },
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 }
          }
        ]
      },
      "layout": { "x": 0, "y": 11, "width": 12, "height": 4 }
    }
  ]
}
