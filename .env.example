# Copy to .env.local and fill in real values. See src/lib/env.ts for the schema
# these are validated against at boot. NEVER commit .env.local — it's gitignored.

# --- Supabase ---
# Local dev values come from `supabase start` output; production values from your
# Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Stripe ---
# Test-mode keys for local dev (https://dashboard.stripe.com/test/apikeys).
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` for local webhook testing.
STRIPE_WEBHOOK_SECRET=

# --- Encryption ---
# 32-byte key for the AES-256-GCM envelope used by src/lib/crypto.ts to encrypt
# integration_connections credentials at rest. Must be 64 hex characters (not
# base64 — hex has one canonical form, base64 has several that can silently
# decode to the wrong byte length). Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# --- Google OAuth (optional locally; required to enable auth.external.google in
# supabase/config.toml) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Datadog (008-observability-as-code) ---
# All optional. Unset, RUM/tracing stay a silent no-op — never a thrown error
# (FR-025/SC-011) — so there is nothing to add to src/lib/env.ts's required schema.
# Full reference: docs/OBSERVABILITY.md.
#
# Client RUM (NEXT_PUBLIC_* — inlined at build time; set in Vercel before the next
# production build or RUM stays dark). From the YogaKit RUM application in
# us5.datadoghq.com, Organization Settings > RUM Applications.
NEXT_PUBLIC_DD_RUM_APPLICATION_ID=
NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=us5.datadoghq.com
NEXT_PUBLIC_DD_SERVICE=yogakit
NEXT_PUBLIC_DD_ENV=prod
NEXT_PUBLIC_DD_VERSION=1.0.0
# Server-side (src/instrumentation.ts's @vercel/otel registration + structured
# logging's dd.trace_id/span_id correlation).
DD_SERVICE=yogakit
DD_ENV=prod
DD_VERSION=1.0.0
# Application Security (enabled in vercel.json for deployed server functions).
# These flags are consumed by dd-trace; they have no effect with @vercel/otel
# alone. See docs/OBSERVABILITY.md, "Application security" before deploying on
# a platform that does not inject the Datadog tracing library.
DD_APPSEC_ENABLED=true
DD_APPSEC_RASP_ENABLED=true
DD_API_SECURITY_ENABLED=true
DD_IAST_ENABLED=true
DD_APPSEC_SCA_ENABLED=true
# Datadog API/App keys — used only by scripts/datadog/sync.mjs and
# scripts/check-telemetry-content-free.mjs's live-handle check, never bundled into
# the app. Organization Settings > API Keys / Application Keys, in us5.
DD_API_KEY=
DD_APP_KEY=
DD_SITE=us5.datadoghq.com
