{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pose",
  "type": "object",
  "required": [
    "slug",
    "sanskrit",
    "english",
    "modes",
    "body_position",
    "energetic_quality",
    "difficulty",
    "complexity",
    "breathing_cues",
    "bilateral",
    "contraindications",
    "props_required",
    "prop_free_variation",
    "source",
    "base_of_support",
    "orientation",
    "cog_height",
    "spinal_action",
    "plane",
    "level",
    "zone",
    "energetic_direction",
    "intensity",
    "default_measure"
  ],
  "x-tier2-properties": [
    "type_tags",
    "muscle_groups",
    "injury_risk",
    "joint_action",
    "primary_joints_involved",
    "nervous_system_effect",
    "tissue_depth",
    "modifications",
    "dosha_affinity",
    "emotional_release_potential",
    "sequencing_position",
    "before_poses",
    "after_poses",
    "chakras",
    "tradition_names",
    "element",
    "meridians",
    "counterposes",
    "rebound_pose",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Canonical identifier. Lowercase, hyphens only, no leading digit."
    },
    "sanskrit": { "type": "string", "minLength": 1 },
    "english": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "tradition_names": {
      "type": "object",
      "description": "Optional per-style display name override. Keys are Style enum values. `english` remains the canonical fallback.",
      "propertyNames": { "enum": ["yin", "vinyasa", "ashtanga", "restorative"] },
      "additionalProperties": { "type": "string", "minLength": 1 },
      "default": {}
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "tissue_target", "hold_range", "cue_notes"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["yin", "yang", "both"] },
          "tissue_target": { "enum": ["connective", "muscular", "both"] },
          "hold_range": {
            "type": "object",
            "required": ["min", "max"],
            "additionalProperties": false,
            "properties": {
              "min": { "type": "number", "minimum": 0 },
              "max": { "type": "number", "minimum": 0 }
            }
          },
          "cue_notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "body_position": {
      "enum": ["supine", "prone", "seated", "kneeling", "standing", "inverted"]
    },
    "meridians": {
      "type": "array",
      "items": { "type": "string" }
    },
    "element": {
      "oneOf": [
        { "enum": ["wood", "fire", "earth", "metal", "water"] },
        { "type": "null" }
      ]
    },
    "energetic_quality": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "grounding",
          "opening",
          "cooling",
          "heating",
          "calming",
          "stimulating"
        ]
      }
    },
    "difficulty": {
      "enum": ["accessible", "intermediate", "advanced"]
    },
    "type_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "forward-fold",
          "backbend",
          "twist",
          "inversion",
          "lateral-stretch",
          "hip-opener",
          "heart-opener",
          "groin-opener",
          "hamstring-stretch",
          "quad-stretch",
          "ankle-opener",
          "shoulder-opener",
          "spinal-compression",
          "spinal-traction",
          "hip-flexor-release",
          "outer-hip",
          "chest-opener",
          "neck-release",
          "sacrum-release",
          "restorative",
          "integration"
        ]
      }
    },
    "muscle_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "psoas",
          "iliacus",
          "hip-flexors",
          "hamstrings",
          "quadriceps",
          "glutes",
          "piriformis",
          "hip-adductors",
          "hip-abductors",
          "IT-band",
          "lumbar-spine",
          "thoracic-spine",
          "cervical-spine",
          "spinal-erectors",
          "chest-pectorals",
          "anterior-shoulder",
          "posterior-shoulder",
          "lats",
          "rhomboids",
          "trapezius",
          "intercostals",
          "diaphragm",
          "calves",
          "tibialis-anterior",
          "plantar-fascia",
          "achilles",
          "ankle-ligaments",
          "wrist-extensors",
          "obliques",
          "sacroiliac-ligaments"
        ]
      }
    },
    "complexity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "1 = total beginner (constructive rest), 10 = very advanced (full saddle, lotus). Yin-specific scale accounting for edge intensity and setup difficulty."
    },
    "injury_risk": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Inherent injury risk of the pose shape regardless of student level. 1 = minimal (savasana), 10 = high (full saddle, snail). Consider joint compression, nerve proximity, and instability vectors."
    },
    "breathing_cues": {
      "type": "object",
      "required": ["entering", "holding", "exiting"],
      "additionalProperties": false,
      "properties": {
        "entering": { "type": "string", "minLength": 1, "description": "Breath guidance for moving into the pose." },
        "holding": { "type": "string", "minLength": 1, "description": "Breath guidance during the hold (yin: what to do with breath, where to feel it)." },
        "exiting": { "type": "string", "minLength": 1, "description": "Breath guidance for coming out of the pose." }
      }
    },
    "joint_action": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "flexion", "extension", "internal_rotation", "external_rotation",
          "abduction", "adduction", "compression", "traction",
          "lateral_flexion", "circumduction", "inversion", "eversion"
        ]
      },
      "description": "Primary joint actions occurring in this pose. Enables precise contraindication matching."
    },
    "primary_joints_involved": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "lumbar", "thoracic", "cervical", "sacroiliac",
          "hip", "knee", "ankle", "toes",
          "shoulder", "elbow", "wrist",
          "feet", "neck"
        ]
      },
      "description": "Joints under meaningful load or stress in this pose."
    },
    "nervous_system_effect": {
      "enum": ["parasympathetic", "sympathetic", "neutral"],
      "description": "Primary autonomic nervous system effect of this pose when held for yin durations. Parasympathetic = calming/restorative; sympathetic = activating."
    },
    "tissue_depth": {
      "enum": ["superficial", "intermediate", "deep"],
      "description": "Depth of connective tissue stress: superficial=skin/superficial fascia, intermediate=muscular fascia/tendons, deep=ligaments/joint capsules/cartilage/bone. Bernie Clark's foundational principle."
    },
    "modifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "accessibility_level"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "props_used": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "accessibility_level": {
            "enum": ["accessible", "intermediate", "advanced"]
          }
        }
      },
      "description": "Pose modifications for different student profiles. Replaces single prop_free_variation with multiple access points."
    },
    "dosha_affinity": {
      "type": "object",
      "required": ["vata", "pitta", "kapha"],
      "additionalProperties": false,
      "properties": {
        "vata":  { "enum": ["balancing", "neutral", "aggravating"] },
        "pitta": { "enum": ["balancing", "neutral", "aggravating"] },
        "kapha": { "enum": ["balancing", "neutral", "aggravating"] }
      },
      "description": "Ayurvedic dosha effects. Balancing = therapeutic for that dosha; aggravating = use with caution for high-dosha students."
    },
    "emotional_release_potential": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["emotion", "tcm_organ"],
        "additionalProperties": false,
        "properties": {
          "emotion": { "type": "string", "minLength": 1 },
          "tcm_organ": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      },
      "description": "Emotions traditionally associated with the targeted meridians/organs. Supports trauma-informed teaching."
    },
    "sequencing_position": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["opening", "building", "peak", "cooldown", "integration"]
      },
      "description": "Where this pose naturally belongs in a class arc. A pose may fit multiple positions."
    },
    "before_poses": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Slugs of poses that warm up / prepare the body for this pose. Not counterposes — opening/approach poses."
    },
    "after_poses": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Slugs of poses that flow naturally after this pose in a sequence. Not counterposes — continuation / deepening options."
    },
    "props_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prop_free_variation": {
      "oneOf": [{ "type": "string" }, { "type": "null" }]
    },
    "counterposes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "rebound_pose": {
      "oneOf": [{ "type": "string" }, { "type": "null" }]
    },
    "contraindications": {
      "type": "array",
      "items": {
        "enum": [
          "high-blood-pressure", "low-blood-pressure", "glaucoma", "pregnancy",
          "no-inversions", "neck-injury", "shoulder-injury", "wrist-injury",
          "elbow-injury", "low-back-injury", "mid-back-injury", "hip-replacement",
          "hip-injury", "knee-injury", "ankle-injury", "sacroiliac-joint",
          "osteoporosis", "herniated-disc", "scoliosis", "meniscus-injury",
          "rotator-cuff", "carpal-tunnel", "sciatica", "fibromyalgia", "arthritis",
          "multiple-sclerosis", "vertigo", "lymphedema", "deep-vein-thrombosis"
        ]
      }
    },
    "bilateral": { "type": "boolean" },
    "source": { "type": "string", "minLength": 1 },
    "notes": { "type": "string", "default": "" },
    "chakras": {
      "type": "array",
      "items": {
        "enum": ["root", "sacral", "solar-plexus", "heart", "throat", "third-eye", "crown"]
      },
      "default": [],
      "description": "Primary chakras activated in this pose. Standard 7-chakra system. Optional — populated progressively."
    },
    "base_of_support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["hands", "feet", "sitbones", "forearms", "knees", "back", "shoulders"]
      },
      "description": "Contact points touching the ground. Feeds the friction engine's contact term (35% weight)."
    },
    "orientation": {
      "enum": ["prone", "supine", "upright", "inverted"],
      "description": "Feeds the friction engine's orientation term (25% weight, combined with level)."
    },
    "cog_height": {
      "enum": ["floor", "low", "mid", "high"],
      "description": "Center-of-gravity height. Feeds the friction engine's cog term (20% weight)."
    },
    "spinal_action": {
      "enum": ["flexion", "extension", "neutral", "lateral", "rotation"],
      "description": "Feeds the friction engine's spine term (10% weight)."
    },
    "plane": {
      "enum": ["sagittal", "coronal", "transverse", "multi"],
      "description": "Feeds the friction engine's plane term (10% weight)."
    },
    "level": {
      "enum": ["high", "middle", "low"],
      "description": "Kinesphere level; combines with orientation for the orientation term."
    },
    "zone": {
      "enum": ["near", "mid-reach", "far"],
      "description": "Kinesphere zone; informative in v0.1, not yet weighted in the friction formula."
    },
    "energetic_direction": {
      "enum": ["brahmana", "langhana", "samana"],
      "description": "Heating/cooling/neutral energetic direction; drives the six-phase template's default intent tags."
    },
    "intensity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "How much this pose asks of the nervous system/tissue. Distinct from complexity (1-10, how hard to enter/hold)."
    },
    "default_measure": {
      "type": "object",
      "oneOf": [
        {
          "required": ["breaths"],
          "properties": { "breaths": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        },
        {
          "required": ["seconds"],
          "properties": { "seconds": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        }
      ],
      "description": "The Compose surface's default hold entry. Distinct from modes[].hold_range, which stays a minutes-based yin-style range."
    }
  }
}
